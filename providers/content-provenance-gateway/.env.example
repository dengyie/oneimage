# Copy to .env and fill in. Never commit the real file.
PORT=8842
HOST=127.0.0.1
OPENAI_API_KEY=
ACCESS_TOKEN=
MAX_BYTES=20971520
UPSTREAM_TIMEOUT_MS=60000
UPLOAD_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=15000
RATE_LIMIT=30
RATE_WINDOW_MS=60000
DAILY_CAP=3000
MAX_CONCURRENCY=4
MAX_UPLOADS=8
CORS_ORIGIN=*
STATE_FILE=./.state.json
# All numeric values above must be plain integers; an invalid one is fatal at startup.
# Anonymous services may only bind loopback; override only behind a trusted proxy:
# ALLOW_ANONYMOUS_PUBLIC_BIND=1
# Upstream proxy, if the host has no direct route to api.openai.com:
# HTTPS_PROXY=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897
